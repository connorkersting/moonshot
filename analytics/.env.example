# Copy to analytics/.env (untracked) and fill in. Shell environment variables win over this file.
# Folder holding the Claude Code transcripts for the project (…/.claude/projects/<project-slug>)
CLAUDE_PROJECT_DIR=
# Transcript id: <CLAUDE_PROJECT_DIR>/<id>.jsonl and <CLAUDE_PROJECT_DIR>/<id>/subagents/
MOONSHOT_SESSION_ID=
# The run's working folder (git repo with ab_key_*.json, qcN/aqcN/tqcN.txt)
MOONSHOT_WORK=
# The run's export folder (PROGRESS.md, versions/*.mp4)
MOONSHOT_EXPORTS=
# Optional: Codex CLI session logs (…/.codex/sessions). Leave empty to skip codex_requests.csv
CODEX_SESSIONS_DIR=
